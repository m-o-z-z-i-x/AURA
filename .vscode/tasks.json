{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Convert UI to PY",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "& \"${workspaceFolder}/.venv/Scripts/pyuic5\" ./ui/gui.ui -o ./gui.py --from-imports; [IO.File]::WriteAllText('./gui.py', (((Get-Content ./gui.py) -notmatch 'import resources_rc') -join [Environment]::NewLine).TrimEnd());",
        "& \"${workspaceFolder}/.venv/Scripts/pyrcc5\" ./res/qrc/resources.qrc -o ./modules/resources.py; [IO.File]::WriteAllText('./modules/resources.py', ([IO.File]::ReadAllText('./modules/resources.py')).TrimEnd())"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Convert UI to Python every time, since ui/gui.ui is the source of truth"
    },
    {
      "label": "Build with Nuitka",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "build.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compilation using Nuitka"
    }
  ]
}