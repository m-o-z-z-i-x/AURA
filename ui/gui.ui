  <property name="styleSheet">
   <string notr="true">/* WINDOW */
       #mainWidget {
           background-color: #212121;
       }
   /* WINDOW */

   /* TABBAR */
       QTabBar::Tab {
           width: 260px;
           padding: 10px 20px;
           color: rgba(255, 255, 255, 0.60);
           border-bottom: 4px solid #212121;
           text-transform: uppercase;
           background-color: #303030;
       }

       QTabBar::Tab:hover {
           color: rgba(255, 255, 255, 0.87);
           background-color: #353535;
       }

       QTabBar::Tab:selected {
           color: rgba(255, 255, 255, 0.87);
           background-color: #292929;
       }

       QTabWidget::pane {
           border: none;
           background-color: #292929;
       }
   /* TABBAR */

   /* WIDGETS */
       QPlainTextEdit {
           padding: 5px;
           color: rgba(255, 255, 255, 0.60);
           border: 1px solid #353535;
           background-color: #303030;
       }

       QPlainTextEdit:hover {
           border: 1px solid #393939;
       }

       QLineEdit {
           padding: 0 8px;
           color: rgba(255, 255, 255, 0.87);
           border: 1px solid #353535;
           background-color: #303030;
       }

       QLineEdit:hover {
           border: 1px solid #393939;
       }

       QLineEdit:focus {
           border: 1px solid #4a4a4a;
       }

       QLineEdit:disabled {
           color: rgba(255, 255, 255, 0.30);
           background-color: #363636;
       }

       QLineEdit[invalid="true"] {
           border: 1px solid #c74040;
       }

       QLabel {
           color: rgba(255, 255, 255, 0.60);
       }

       QLabel:disabled {
           color: rgba(255, 255, 255, 0.30);
       }

       QPushButton {
           color: rgba(255, 255, 255, 0.60);
           border: 1px solid #353535;
           background-color: #303030;
       }

       QPushButton:hover {
           color: rgba(255, 255, 255, 0.87);
           background-color: #393939;
       }

       QPushButton:pressed {
           color: rgba(255, 255, 255, 0.87);
           border: 1px solid #2f2f2f;
           background-color: #2a2a2a;
       }

       QPushButton:disabled {
           color: rgba(255, 255, 255, 0.30);
           background-color: #363636;
       }

       QCheckBox {
           color: rgba(255, 255, 255, 0.60);
       }

       QCheckBox:disabled {
           color: rgba(255, 255, 255, 0.30);
       }

       QCheckBox::indicator {
           width: 12px;
           height: 12px;
           background-color: rgba(255, 255, 255, 0.30);
       }

       QCheckBox::indicator:checked {
           background-color: rgba(255, 255, 255, 0.60);
       }

       QCheckBox::indicator:disabled {
           background-color: rgba(255, 255, 255, 0.15);
       }

       QCheckBox::indicator:checked:disabled {
           background-color: rgba(255, 255, 255, 0.30);
       }

       QComboBox {
           padding: 0 5px;
           color: rgba(255, 255, 255, 0.60);
           border: 1px solid #353535;
           background-color: #303030;
       }

       QComboBox:hover {
           border: 1px solid #393939;
       }

       QComboBox:disabled {
           color: rgba(255, 255, 255, 0.30);
           background-color: #363636;
       }

       QComboBox::drop-down {
           width: 18px;
           border: none;
       }

       QComboBox::down-arrow {
           width: 10px;
           height: 10px;
           image: url(:/icons/icons/arrow_down.png);
       }

       QComboBox::down-arrow:on {
           image: url(:/icons/icons/arrow_up.png);
       }

       QComboBox QAbstractItemView {
           color: rgba(255, 255, 255, 0.60);
           border: 1px solid #353535;
           background-color: #393939;
           selection-color: rgba(255, 255, 255, 0.87);
           selection-background-color: #424242;
       }

       QProgressBar {
           border: 1px solid #353535;
           background-color: #1c1c1c;
       }

       QProgressBar::chunk {
           width: 5px;
           margin: 1px;
           background-color: #5a5a5a;
       }

       QProgressBar::chunk:disabled {
           background-color: transparent;
       }

       QDialog {
           background-color: #292929;
       }

       #dialogMessage {
           font-size: 9pt;
           color: rgba(255, 255, 255, 0.87);
       }

       #dialogDetail {
           color: rgba(255, 255, 255, 0.60);
       }

       #choiceDialog QPushButton:default {
           border: 1px solid #4a4a4a;
       }

       #choiceDialog QPushButton[danger="true"] {
           color: #e08a8a;
           border: 1px solid #4a3030;
       }

       #choiceDialog QPushButton[danger="true"]:hover {
           color: #f0a0a0;
           border: 1px solid #6a3a3a;
           background-color: #3a2f2f;
       }

       QScrollBar:vertical {
           width: 20px;
           margin: 5px;
           border: none;
           background-color: #393939;
       }

       QScrollBar::handle:vertical {
           border: none;
           background-color: #444;
       }

       QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
           background-color: none;
       }

       QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
           background-color: none;
       }
   /* WIDGETS */

   /* MAIN-TAB */
       #mainTab {
           background-color: #292929;
       }

       #connectionPanel, #sessionPanel, #statusBar {
           border: 1px solid #353535;
           background-color: #2b2b2b;
       }

       #logPanel {
           padding: 3px 8px;
           background-color: #2b2b2b;
       }

       #sessionLine_1, #sessionLine_2, #sessionLine_3, #sessionLine_4 {
           border: none;
           background-color: #353535;
       }

       #sessionCaption {
           color: rgba(255, 255, 255, 0.30);
       }

       #sessionStatus, #sessionTimer, #localIp, #serverIp, #ipsecInfo, #pppInfo, #downloadSpeed, #uploadSpeed {
           color: rgba(255, 255, 255, 0.87);
       }

       #sessionStatus:disabled, #sessionTimer:disabled, #localIp:disabled, #serverIp:disabled, #ipsecInfo:disabled, #pppInfo:disabled, #downloadSpeed:disabled, #uploadSpeed:disabled {
           color: rgba(255, 255, 255, 0.30);
       }

       #statusIndicator, #statusBarIndicator {
           border-radius: 4px;
           background-color: rgba(255, 255, 255, 0.15);
       }
   /* MAIN-TAB */

   /* ABOUT-TAB */
       #aboutTab {
           background-color: #292929;
       }

       #programIcon {
           width: 100%;
           height: 100%;
           background-image: url(:/icons/icons/logo.png);
           background-repeat: norepeat;
           background-position: 50% 50%;
       }
   /* ABOUT-TAB */</string>
